# Host directory used for the persistent Hugging Face model cache.
HF_HOME=D:\\_models\\huggingface

# Stable API-facing name, independent from the Hugging Face repository ID.
VLLM_SERVED_MODEL_NAME=qwen3-8b-awq
VLLM_MODEL=Qwen/Qwen3-8B-AWQ
VLLM_PORT=8000
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEMORY_UTILIZATION=0.85

# Application client settings. The key is deliberately non-secret for localhost.
LLM_API_KEY=local
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=qwen3-8b-awq
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0
LLM_SEED=0

